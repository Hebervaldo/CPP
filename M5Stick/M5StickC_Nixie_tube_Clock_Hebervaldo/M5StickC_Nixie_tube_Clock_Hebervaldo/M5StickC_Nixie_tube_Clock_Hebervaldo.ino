void fade() {
  for (int i = 7; i < 16; i++) {
    M5.Axp.ScreenBreath(i);
    delay(25);
  }
  for (int i = 15; i > 7; i--) {
    M5.Axp.ScreenBreath(i);
    delay(25);
  }
  M5.Axp.ScreenBreath(12);
}
