  M5.Rtc.GetTime(&RTC_TimeStruct);
  // M5.Rtc.GetData(&RTC_DateStruct);

  // read the state of the switch/button:
  currentState_M5_BUTTON_HOME = digitalRead(M5_BUTTON_HOME);

  if (lastState_M5_BUTTON_HOME == HIGH && currentState_M5_BUTTON_HOME == LOW)
  {
    blnBotaoPressionado_M5_BUTTON_HOME = true;
    intIntervaloAnteriorSleep = millis();
  }

  if (M5.Axp.GetBtnPress() == 0x02)
  {
    blnBotaoPressionado_M5_BUTTON_PWR01S = true;
    intIntervaloAnteriorSleep = millis();
  }

  if (M5.Axp.GetBtnPress() == 0x01)
  {
    blnBotaoPressionado_M5_BUTTON_PWR02S = true;
    intIntervaloAnteriorSleep = millis();
  }

  if (millis() - intIntervaloAnterior >= 100)
  {
    intIntervaloAnterior = millis();

    // save the the last state
    lastState_M5_BUTTON_HOME = currentState_M5_BUTTON_HOME;

    if ( mode_ == 6 ) {
      vfd_6_line(); // temperature
    }
    if ( mode_ == 5 ) {
      vfd_5_line(); // temperature
    }
    if ( mode_ == 4 ) {
      vfd_4_line(); // sensor distance meter
    }
    if ( mode_ == 3 ) {
      vfd_3_line(); // hh,mm,ss
    }
    if ( mode_ == 2 ) {
      vfd_2_line(); // yyyy,mm,dd,hh,mm,ss
    }
    if ( mode_ == 1 ) {
      vfd_1_line(); // mm,ss
    }

    if (blnBotaoPressionado_M5_BUTTON_HOME)
    {
      blnBotaoPressionado_M5_BUTTON_HOME = false;

      if (mode_ == 6) {
        mode_ = 1;
        M5.Lcd.fillScreen(BLACK);
        return;
      }
      if (mode_ == 5) {
        mode_ = 6;
        M5.Lcd.fillScreen(BLACK);
        return;
      }
      if (mode_ == 4) {
        mode_ = 5;
        M5.Lcd.fillScreen(BLACK);
        return;
      }
      if (mode_ == 3) {
        mode_ = 4;
        M5.Lcd.fillScreen(BLACK);
        return;
      }
      if (mode_ == 2) {
        mode_ = 3;
        M5.Lcd.fillScreen(BLACK);
        return;
      }
      if (mode_ == 1) {
        mode_ = 2;
        M5.Lcd.fillScreen(BLACK);
        return;
      }
    }

    if (blnBotaoPressionado_M5_BUTTON_PWR01S)
    {
      blnBotaoPressionado_M5_BUTTON_PWR01S = false;
      
      if (blnLEDREDLigado)
      {
        digitalWrite(10, LOW);
        blnLEDREDLigado = false;
      }
      else
      {
        digitalWrite(10, HIGH);
        blnLEDREDLigado = true;
      }
    }

    if (blnBotaoPressionado_M5_BUTTON_PWR02S)
    {
      blnBotaoPressionado_M5_BUTTON_PWR02S = false;

      if (blnLEDIRLigado)
      {
        digitalWrite(9, LOW);
        blnLEDIRLigado = false;
      }
      else
      {
        digitalWrite(9, HIGH);
        blnLEDIRLigado = true;
      }
    }

    if (millis() - intIntervaloAnteriorSleep >= 60000)
    {
      intIntervaloAnteriorSleep = millis();
      mtdDeepSleep(GPIO_NUM_37);
    }
  }
}

void vfd_6_line()
{
  TensaoBateriaS =  M5.Axp.GetBatVoltage();
  PercentualCargaBateria = mtdObterNivelBateria(TensaoBateriaS) * 10;

  M5.Rtc.GetTime(&RTC_TimeStruct);
  M5.Rtc.GetData(&RTC_DateStruct);

  int d1 = int(PercentualCargaBateria / 1000);
  int d2 = int((PercentualCargaBateria - d1 * 1000) / 100);
  int d3 = int((PercentualCargaBateria - d1 * 1000 - d2 * 100) / 10);
  int d4 = int(PercentualCargaBateria - d1 * 1000 - d2 * 100 - d3 * 10);

  M5.Rtc.GetTime(&RTC_TimeStruct);
  M5.Rtc.GetData(&RTC_DateStruct);
  int h1 = int(RTC_TimeStruct.Hours / 10 );
  int h2 = int(RTC_TimeStruct.Hours - h1 * 10 );
  int i1 = int(RTC_TimeStruct.Minutes / 10 );
  int i2 = int(RTC_TimeStruct.Minutes - i1 * 10 );
  int s1 = int(RTC_TimeStruct.Seconds / 10 );
  int s2 = int(RTC_TimeStruct.Seconds - s1 * 10 );

  M5.Lcd.pushImage(  2, 0, 35, 67, (uint16_t *)m[h1]);
  M5.Lcd.pushImage( 41, 0, 35, 67, (uint16_t *)m[h2]);
  M5.Lcd.drawPixel( 79, 22, ORANGE); M5.Lcd.drawPixel( 79, 48, ORANGE);
  M5.Lcd.drawPixel( 79, 21, YELLOW); M5.Lcd.drawPixel( 79, 47, YELLOW);
  M5.Lcd.pushImage( 83, 0, 35, 67, (uint16_t *)m[i1]);
  M5.Lcd.pushImage(121, 0, 35, 67, (uint16_t *)m[i2]);
  M5.Lcd.pushImage(140, 45, 18, 34, (uint16_t *)n[d4]);
  M5.Lcd.drawPixel(139, 74, ORANGE);
  M5.Lcd.drawPixel(139, 73, YELLOW);  
  M5.Lcd.pushImage(120, 45, 18, 34, (uint16_t *)n[d3]);
  M5.Lcd.pushImage(100, 45, 18, 34, (uint16_t *)n[d2]);
  // M5.Lcd.drawPixel(99, 74, ORANGE);
  // M5.Lcd.drawPixel(99, 73, YELLOW);
  M5.Lcd.pushImage(80, 45, 18, 34, (uint16_t *)n[d1]);

  // if ( s1 == 0 && s2 == 0 ){ fade();}
}

